rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
    }

    match /incidents/{incidentId} {
      allow read: if signedIn() && resource.data.siteId == userProfile().siteId;
      allow create: if signedIn()
        && request.resource.data.guardId == request.auth.uid
        && request.resource.data.siteId == userProfile().siteId;
      allow update: if signedIn()
        && resource.data.siteId == userProfile().siteId
        && request.resource.data.siteId == resource.data.siteId;
    }
  }
}
